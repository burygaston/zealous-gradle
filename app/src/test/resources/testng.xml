<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Task Manager Selenium Test Suite" verbose="1">
    <listeners>
        <!-- Built-in TestNG JUnit XML reporter -->
        <listener class-name="org.testng.reporters.JUnitXMLReporter"/>
    </listeners>

    <!-- Smoke Test Suite -->
    <test name="Smoke Tests" group-by-instances="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.taskmanager.selenium.tests.BasicUISeleniumTest"/>
        </classes>
    </test>

    <!-- Google Search Tests -->
    <test name="Google Search Tests" group-by-instances="true">
        <classes>
            <class name="com.taskmanager.selenium.tests.GoogleSearchSeleniumTest"/>
        </classes>
    </test>

    <!-- Regression Test Suite -->
    <test name="Regression Tests" group-by-instances="true">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.taskmanager.selenium.tests.BasicUISeleniumTest"/>
        </classes>
    </test>
</suite>
